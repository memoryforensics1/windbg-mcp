{
  "Vm": {
    "VmxPath": "C:\\path\\to\\your\\vm.vmx",
    "VmrunPath": "C:\\Program Files (x86)\\VMware\\VMware Workstation\\vmrun.exe",
    "HostType": "ws",
    "HostUrl": "",
    "HostUsername": "",
    "HostPassword": "",
    "VmPassword": "",
    "GuestUsername": "YourUser",
    "GuestPassword": "YourPass",
    "Headless": true
  },
  "KernelDebug": {
    "Transport": "kdnet",
    "Kdnet": {
      "Port": 50000,
      "Key": "your.kdnet.key.here"
    },
    "Serial": {
      "PipeName": "\\\\.\\pipe\\com_1"
    },
    "SymbolPath": "srv*C:\\Symbols*https://msdl.microsoft.com/download/symbols"
  },
  "Guest": {
    "FridaPort": 27042,
    "DbgsrvPort": 5064
  },
  "Security": {
    "SnapshotDeleteEnabled": false,
    "ProtectedSnapshots": ["your-known-good-snapshot"],
    "DefaultSnapshotName": "your-known-good-snapshot",
    "PreventLastSnapshotDeletion": true
  },
  "Timeouts": {
    "VmStartSeconds": 60,
    "VmStopSeconds": 30,
    "VmPauseResumeSeconds": 10,
    "VmSnapshotCreateSeconds": 120,
    "VmSnapshotRestoreSeconds": 60,
    "VmScreenshotSeconds": 10,
    "VmToolsCheckSeconds": 5,
    "VmGetIpSeconds": 10,
    "KdConnectSeconds": 30,
    "KdInitialBreakSeconds": 15,
    "KdBreakSeconds": 10,
    "KdStepSeconds": 10,
    "KdCommandExecuteSeconds": 30,
    "KdMemoryReadSeconds": 10,
    "KdMemoryWriteSeconds": 10,
    "KdWaitForBreakpointSeconds": 10,
    "GuestCommandSeconds": 60,
    "GuestFileTransferSeconds": 120,
    "GuestListProcessesSeconds": 15,
    "GuestKillProcessSeconds": 10,
    "FridaAttachSeconds": 15,
    "FridaScriptSeconds": 30,
    "DbgsrvConnectSeconds": 15,
    "TtdRecordMinutes": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "WinDbgMCP": "Debug"
    }
  }
}
